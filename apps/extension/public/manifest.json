{
  "manifest_version": 3,
  "name": "USC Course Planner",
  "version": "0.1.0",
  "description": "Plan USC sections with your local course service and export for your assistant.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:3000/*"],
  "action": {
    "default_title": "Open USC Course Planner"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
