{
  "manifest_version": 3,
  "name": "USC Course Planner",
  "version": "0.2.0",
  "description": "Plan USC courses in a side panel with your own Codex companion and validated schedule drafts.",
  "key": "",
  "permissions": ["storage", "sidePanel", "nativeMessaging"],
  "minimum_chrome_version": "116",
  "side_panel": { "default_path": "index.html" },
  "host_permissions": ["http://127.0.0.1:3000/*", "https://webreg.usc.edu/*"],
  "content_scripts": [
    {
      "matches": [
        "https://webreg.usc.edu/CourseBin*",
        "https://webreg.usc.edu/Courses*",
        "https://webreg.usc.edu/Departments*",
        "https://webreg.usc.edu/Search*",
        "https://webreg.usc.edu/Calendar*"
      ],
      "js": ["coursebin.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open USC Course Planner"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
