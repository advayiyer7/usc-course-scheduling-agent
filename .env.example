# Optional: omit DATABASE_URL for single-process embedded PostgreSQL development.
# DATABASE_URL=postgres://usc:usc@127.0.0.1:5432/usc
PGLITE_DIR=./data/local
HOST=127.0.0.1
PORT=3000
# Local development only. Production OAuth and provider onboarding are not implemented.
SOURCE_REQUEST_INTERVAL_MS=1000
SOURCE_TIMEOUT_MS=45000
SOURCE_MAX_ATTEMPTS=3

# Full semester cache reconciliation; runs in the API's embedded worker or npm run worker.
SEMESTER_REFRESH_ENABLED=true
SEMESTER_REFRESH_HOURS=24
# Optional explicit terms (also imports uncached terms). Default: cached current/upcoming terms.
# SEMESTER_REFRESH_TERMS=20263,20271

# Forwarding pilot: synthetic alert button; no real mail or registration is sent.
ALERTS_PILOT_ENABLED=false
# Optional receiving setup. These credentials stay in the backend environment.
# A Resend-managed <id>.resend.app receiving domain also works; no domain purchase needed.
# See docs/mail-setup.md, then run npm run mail:check (configuration only).
# ALERTS_INBOUND_DOMAIN=your-account.resend.app
# RESEND_API_KEY=...
# RESEND_WEBHOOK_SECRET=whsec_...
# The isolated receiver binds 127.0.0.1 on this port, separate from the planner API.
# ALERTS_MAIL_PORT=3001
